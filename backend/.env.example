# Copy this file to .env and adjust the values for your environment.

# Server
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=app
DB_PASSWORD=app_password
DB_NAME=app_db

# Auth — generate a strong secret with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Set to a bcrypt hash of the admin password. If unset, admin login is disabled.
ADMIN_PASSWORD_HASH=
